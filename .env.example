# Copy this to .env for local wrangler dev (never commit .env)
# For production, use `wrangler secret put` or GitHub Actions secrets.

GATEWAY_SECRET=change-me-strong-random-string
ADMIN_SECRET=change-me-different-strong-string

# Optional: seed keys on first deploy (JSON array).
# After seeding, manage keys via the admin dashboard instead.
# STRAITLY_KEYS_JSON=["sk-key1","sk-key2","sk-key3"]
